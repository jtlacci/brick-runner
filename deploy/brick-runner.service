# systemd unit for the polling service. Copy to /etc/systemd/system/, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now brick-runner
# Logs: journalctl -u brick-runner -f   (one JSON object per line)

[Unit]
Description=brick-runner: evaluate pull requests for a brick repository
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brick-runner
Group=brick-runner
# Root-owned (chmod 600). systemd reads it as root before it starts the service.
EnvironmentFile=/etc/brick-runner/env
# The GitHub App key, root-owned; the service reads it from $CREDENTIALS_DIRECTORY.
LoadCredential=app-key:/etc/brick-runner/app-key.pem
LoadCredential=judge-key:/etc/brick-runner/judge-key
Environment=BRICK_RUNNER_HOME=/var/lib/brick-runner
ExecStart=/opt/brick-runner/venv/bin/brick-runner serve \
    --github jtlacci/YOUR-BRICK-REPO \
    --allow jtlacci \
    --interval 60 \
    --sync-every 600
Restart=on-failure
RestartSec=30

# The runner needs user namespaces for its sandbox: do not add
# PrivateUsers= or RestrictNamespaces=.
NoNewPrivileges=yes
ProtectSystem=full
StateDirectory=brick-runner
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
