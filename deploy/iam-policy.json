{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheBackupPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::YOUR-BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["brick-runner/*", "brick-runner"]}}
    },
    {
      "Sid": "ReadAndWriteObjectsButNeverDelete",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::YOUR-BUCKET/brick-runner/*"
    }
  ]
}
